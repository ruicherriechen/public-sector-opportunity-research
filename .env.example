# Copy this file to .env and adjust paths if needed.
RAG_DATABASE_PATH=data/opportunity_research.sqlite3
RAG_CHUNK_TARGET_TOKENS=500
RAG_CHUNK_MAX_TOKENS=600
RAG_CHUNK_OVERLAP_TOKENS=60
RAG_HTTP_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MODEL_CACHE_PATH=.cache/models
RAG_MODEL_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=32

# LangGraph orchestration. This database stores workflow checkpoints only;
# evidence and retrieval traces remain in RAG_DATABASE_PATH.
LANGGRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.sqlite3
LANGGRAPH_MAX_ITERATIONS=2
LANGGRAPH_MAX_AGENT_CALLS=6
LANGGRAPH_MAX_INPUT_TOKENS=50000
LANGGRAPH_MAX_OUTPUT_TOKENS=6000
# Source excerpts supplied to the Procurement Researcher only (2000-4000).
PROCUREMENT_CONTEXT_TOKENS=3000
STRATEGY_CONTEXT_TOKENS=3000

# OpenAI opportunity assessment. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_ASSESSMENT_MODEL=gpt-6-luna
# Used only with the explicit graph flag: --model-provider openai
OPENAI_AGENT_MODEL=gpt-6-luna

# Agent-provider routing. Stage values override the global value. Mock remains
# the safe default. Codex uses your existing Codex login, not OPENAI_API_KEY.
AGENT_MODEL_PROVIDER=mock
STRATEGY_MODEL_PROVIDER=
PROCUREMENT_MODEL_PROVIDER=
SYNTHESIS_MODEL_PROVIDER=
CODEX_AGENT_MODEL=gpt-6.1-sol
CODEX_TIMEOUT_SECONDS=300
CODEX_REASONING_EFFORT=medium

# Streamlit self-service research authorization. These are limits, not targets;
# the UI never falls back to OpenAI API. With three normal agent stages, the
# three-call aggregate budget leaves no spare provider call for a retry.
SELF_SERVICE_MODEL_PROVIDER=codex
SELF_SERVICE_AGENT_MODEL=gpt-6.1-sol
SELF_SERVICE_MAX_MODEL_CALLS=3
SELF_SERVICE_MAX_INPUT_TOKENS=50000
SELF_SERVICE_MAX_OUTPUT_TOKENS=6000
SELF_SERVICE_STRATEGY_CONTEXT_TOKENS=3000
SELF_SERVICE_PROCUREMENT_CONTEXT_TOKENS=3000
SELF_SERVICE_MAX_TRANSIENT_RETRIES=1

# Optional official-source discovery. USAspending itself requires no key.
BRAVE_SEARCH_API_KEY=
WEB_RESEARCH_FRESHNESS_DAYS=365
WEB_RESEARCH_MAX_SEARCHES=6
WEB_RESEARCH_MAX_URLS=20
WEB_RESEARCH_MAX_DOCUMENT_BYTES=10000000
WEB_RESEARCH_MAX_TOTAL_BYTES=30000000
WEB_RESEARCH_MAX_RUNTIME_SECONDS=120
WEB_RESEARCH_MAX_RETRIES=2
WEB_RESEARCH_MAX_REDIRECTS=3

