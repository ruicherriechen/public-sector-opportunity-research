# Copy this file to .env and adjust paths if needed.
RAG_DATABASE_PATH=data/opportunity_research.sqlite3
RAG_CHUNK_TARGET_TOKENS=500
RAG_CHUNK_MAX_TOKENS=600
RAG_CHUNK_OVERLAP_TOKENS=60
RAG_HTTP_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_MODEL_CACHE_PATH=.cache/models
RAG_MODEL_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=32

# LangGraph orchestration. This database stores workflow checkpoints only;
# evidence and retrieval traces remain in RAG_DATABASE_PATH.
LANGGRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.sqlite3
LANGGRAPH_MAX_ITERATIONS=2

# OpenAI opportunity assessment. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_ASSESSMENT_MODEL=gpt-6-luna

